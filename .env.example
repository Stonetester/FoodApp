# Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Environment (development, production, testing)
FLASK_ENV=development

# Secret Key for Sessions (generate with: python -c "import os; print(os.urandom(24).hex())")
SECRET_KEY=your-secret-key

# Database Configuration
# Format: mysql+pymysql://username:password@host/database
DATABASE_URL=mysql+pymysql://root:PASSWORD@127.0.0.1:3306/foodapp

# Optional: For production deployment
# SESSION_COOKIE_SECURE=1        # Set to 1 when using HTTPS / Cloudflare
# SESSION_COOKIE_SAMESITE=Lax    # Lax works behind Cloudflare

# Waitress production server settings (used when FLASK_ENV=production)
# WAITRESS_THREADS=8              # Worker threads (increase if high traffic)
# WAITRESS_CONNECTION_LIMIT=500   # Max simultaneous connections
# WAITRESS_CHANNEL_TIMEOUT=120    # Idle connection timeout in seconds

# Database pool settings
# DB_POOL_RECYCLE=1800            # Recycle DB connections after N seconds
# DB_POOL_SIZE=10                 # Number of persistent connections
# DB_MAX_OVERFLOW=20              # Extra connections allowed above pool_size

TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe