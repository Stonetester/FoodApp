# Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Environment (development, production, testing)
FLASK_ENV=development

# Secret Key for Sessions (generate with: python -c "import os; print(os.urandom(24).hex())")
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database Configuration
# Format: mysql+pymysql://username:password@host/database
DATABASE_URL=mysql+pymysql://foodapp_user:CosyCottage2026@localhost/foodapp

# Optional: For production deployment
# SESSION_COOKIE_SECURE=True  # Only with HTTPS

  TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe