# ModoGusto backend environment — copy to .env and fill in real values.
# NEVER commit the real .env.

# Required in production (run.py refuses to start without these)
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=mysql+pymysql://user:password@localhost/foodapp

# Session cookies (production defaults shown)
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax

# Cross-origin access — leave unset for normal same-origin hosting.
# Only set if a separate frontend origin must call this API with credentials.
#CORS_ORIGINS=https://app.example.com

# Email (Resend/SendGrid compatible)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notifications@modogusto.com
SENDGRID_FROM_NAME=Modo Gusto
ADMIN_EMAIL=
APP_BASE_URL=https://modogusto.example.com

# OCR
#TESSERACT_CMD=/usr/bin/tesseract

# AI features (Meals Like This) — any OpenAI-compatible endpoint.
# Leave unset to run with AI features disabled (friendly disabled state).
#FRONTIER_MODEL_API_KEY=
#FRONTIER_MODEL_NAME=claude-sonnet-5
#FRONTIER_MODEL_BASE_URL=https://api.openai.com/v1
